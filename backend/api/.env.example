PORT=8080
APP_ENV=development

# --- Local Supabase (Docker) ---
# These are the Supabase CLI's fixed local demo values — identical on every
# machine running `supabase start`, safe to commit as the default. Run
# `make supabase-start` first; `make supabase-status` reprints them if needed.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# --- Resend (family invite emails) ---
# Get a key at https://resend.com/api-keys. Leave unset in local dev and
# invite emails are skipped (the invite is still recorded, just not sent).
RESEND_API_KEY=

# --- Google sign-in ---
# OAuth Client ID from console.cloud.google.com -> APIs & Services ->
# Credentials. Not a secret (also embedded in frontend code) — must match
# the frontend's VITE_GOOGLE_CLIENT_ID exactly, since it's checked as the
# token's audience.
GOOGLE_CLIENT_ID=

# --- Hosted Supabase (supabase.com project) ---
# Replace the five values above with these instead:
#   DATABASE_URL               Project Settings -> Database -> Connection string (direct connection)
#   SUPABASE_URL                Project Settings -> API -> Project URL
#   SUPABASE_ANON_KEY            Project Settings -> API -> anon public key
#   SUPABASE_SERVICE_ROLE_KEY       Project Settings -> API -> service_role key (keep secret)
#   JWT_SECRET                  Project Settings -> API -> JWT Settings -> JWT Secret
